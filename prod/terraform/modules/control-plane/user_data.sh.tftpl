#!/bin/bash
# Control Plane 부팅 스크립트 (무인 부트스트랩)
#  1) hostname + kubeadm init (AMI에 프리풀된 버전으로 고정)
#  2) Calico 매니페스트 apply — CNI는 day-0라 ArgoCD가 관리할 수 없다
#  3) join 커맨드를 SSM SecureString으로 발행 + 갱신 cron (App ASG 신규 노드가 읽어간다)
#  4) (버킷 주입 시) etcd 스냅샷 백업 cron
# 로그: /var/log/cardinal-bootstrap.log
set -euxo pipefail
exec > >(tee -a /var/log/cardinal-bootstrap.log) 2>&1

hostnamectl set-hostname ${hostname}

# ── awscli 확보 (AMI에 없을 수 있음) ──
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y unzip
  curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi
export PATH="$PATH:/usr/local/bin"

# ── IMDSv2 메타데이터 ──
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
meta() { curl -s -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/$1"; }
INSTANCE_ID=$(meta instance-id)
AZ=$(meta placement/availability-zone)
PRIVATE_IP=$(meta local-ipv4)

export KUBECONFIG=/etc/kubernetes/admin.conf

# ═══════════════════════════════════════════════════════
#  1) kubeadm init  (admin.conf가 있으면 이미 초기화된 노드 → 건너뜀)
# ═══════════════════════════════════════════════════════
if [ ! -f /etc/kubernetes/admin.conf ]; then
  # provider-id가 없으면 Cluster Autoscaler가 노드↔EC2 매핑을 못 한다(워커와 동일 이유).
  # v1beta4부터 kubeletExtraArgs는 map이 아니라 name/value 목록이다.
  cat >/etc/kubernetes/kubeadm-init.yaml <<EOF
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: $PRIVATE_IP
  bindPort: 6443
nodeRegistration:
  name: ${hostname}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: provider-id
      value: aws:///$AZ/$INSTANCE_ID
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: ${kubernetes_version}
controlPlaneEndpoint: $PRIVATE_IP:6443
networking:
  # Calico 기본 IP 풀과 일치시킨다. VPC 대역과 겹치지 않는 값이어야 한다.
  podSubnet: ${pod_subnet}
EOF

  # AMI에 이미지가 프리풀돼 있어 레지스트리 pull 없이 뜬다(무인 부팅의 실패 지점 최소화).
  kubeadm init --config /etc/kubernetes/kubeadm-init.yaml

  # 관리자 kubectl (SSM 접속 후 sudo -i 로 사용)
  mkdir -p /root/.kube
  cp -f /etc/kubernetes/admin.conf /root/.kube/config
  chmod 600 /root/.kube/config

  # ── 2) Calico — AMI에 구워둔 매니페스트(VXLAN=Always) ──
  # apiserver가 응답할 때까지 기다린 뒤 apply. CNI가 없으면 다른 파드는 Pending이다.
  for _ in $(seq 1 60); do
    kubectl get --raw='/readyz' >/dev/null 2>&1 && break
    sleep 5
  done
  kubectl apply -f ${calico_manifest}
fi

# ═══════════════════════════════════════════════════════
#  3) join 커맨드 발행 — App ASG 신규 노드가 SSM에서 읽어간다
# ═══════════════════════════════════════════════════════
# 부트스트랩 토큰 TTL은 24시간이라 축제 중 만료된다.
# cron이 새 토큰을 찍어 파라미터를 덮어써, 언제 뜬 노드든 유효한 토큰을 받는다.
cat >/usr/local/bin/publish-join-command.sh <<'EOS'
#!/bin/bash
set -euo pipefail
export PATH="$PATH:/usr/local/bin"
export KUBECONFIG=/etc/kubernetes/admin.conf

IMDS_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
REGION=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  "http://169.254.169.254/latest/meta-data/placement/region")

JOIN_CMD=$(kubeadm token create --ttl 24h --print-join-command)

aws ssm put-parameter \
  --name "CARDINAL_JOIN_PARAM" \
  --type SecureString \
  --value "$JOIN_CMD" \
  --overwrite \
  --region "$REGION"
EOS
sed -i "s|CARDINAL_JOIN_PARAM|${join_param}|" /usr/local/bin/publish-join-command.sh
chmod +x /usr/local/bin/publish-join-command.sh

# 즉시 1회 발행(대기 중이던 App 노드가 이 시점에 붙는다) + 주기 갱신
/usr/local/bin/publish-join-command.sh
echo '${token_refresh_cron} root /usr/local/bin/publish-join-command.sh >> /var/log/join-token.log 2>&1' \
  >/etc/cron.d/publish-join-command

%{ if etcd_backup_bucket != "" ~}
# ═══════════════════════════════════════════════════════
#  4) 백업 — etcd 스냅샷(etcd/) + PKI(pki/)
# ═══════════════════════════════════════════════════════
# 둘 다 있어야 복구가 된다. CA 개인키는 etcd 안이 아니라 /etc/kubernetes/pki에
# 파일로 있어서, 스냅샷만 복원하면 모든 인증서·ServiceAccount 토큰이 무효가 된다.
cat >/usr/local/bin/etcd-backup.sh <<'EOS'
#!/bin/bash
set -euo pipefail
export PATH="$PATH:/usr/local/bin"
BUCKET="CARDINAL_BACKUP_BUCKET"
TS=$(date +%Y%m%d-%H%M%S)
SNAP="/var/lib/etcd-backup/etcd-$TS.db"
mkdir -p /var/lib/etcd-backup

ETCD_ARGS="--endpoints=https://127.0.0.1:2379 \
  --cacert=/etc/kubernetes/pki/etcd/ca.crt \
  --cert=/etc/kubernetes/pki/etcd/server.crt \
  --key=/etc/kubernetes/pki/etcd/server.key"

# etcdctl은 호스트에 없을 수 있다(kubeadm은 etcd를 정적 파드로만 띄운다).
# 없으면 etcd 컨테이너 안의 etcdctl을 쓴다. /var/lib/etcd는 hostPath라 결과가 호스트에 남는다.
if command -v etcdctl >/dev/null 2>&1; then
  ETCDCTL_API=3 etcdctl $ETCD_ARGS snapshot save "$SNAP"
else
  CID=$(crictl ps --name '^etcd$' -q | head -1)
  crictl exec "$CID" etcdctl $ETCD_ARGS snapshot save "/var/lib/etcd/snap-$TS.db"
  mv "/var/lib/etcd/snap-$TS.db" "$SNAP"
fi

aws s3 cp "$SNAP" "s3://$BUCKET/etcd/"
rm -f "$SNAP"

# PKI는 CA 개인키를 담고 있어 SSE-KMS로 한 겹 더 감싼다(버킷 기본값은 SSE-S3).
tar czf "/tmp/pki-$TS.tar.gz" -C / etc/kubernetes/pki
aws s3 cp "/tmp/pki-$TS.tar.gz" "s3://$BUCKET/pki/" --sse aws:kms
rm -f "/tmp/pki-$TS.tar.gz"
EOS
sed -i "s|CARDINAL_BACKUP_BUCKET|${etcd_backup_bucket}|" /usr/local/bin/etcd-backup.sh
chmod +x /usr/local/bin/etcd-backup.sh

# 매일 03:00 백업
echo '0 3 * * * root /usr/local/bin/etcd-backup.sh >> /var/log/etcd-backup.log 2>&1' \
  >/etc/cron.d/etcd-backup

# ── 재해 복구 스크립트 (굽기만 하고 자동 실행하지 않는다) ──
# 자동화하면 멀쩡한 클러스터에 새 CP가 뜰 때 옛 스냅샷을 덮어쓸 수 있다.
cat >/usr/local/bin/restore-cluster.sh <<'EOS'
#!/bin/bash
# CP 재해 복구 — 관리자가 SSM으로 접속해 직접 실행한다.
#
# 실행 전 확인:
#   1. 이 노드가 "교체된 빈 CP"인가? 기존 CP가 살아 있으면 실행하지 말 것.
#   2. 사설 IP가 예전과 같은가? (terraform control_plane_private_ip 고정값)
#      다르면 인증서 SAN이 어긋나 apiserver가 뜨지 않는다.
#   3. App ASG를 desired=0으로 내려둘 것. 복구 전 발행된 임시 토큰으로
#      새 노드가 "잘못된 클러스터"에 붙는 것을 막는다.
set -euo pipefail
export PATH="$PATH:/usr/local/bin"
BUCKET="CARDINAL_BACKUP_BUCKET"

read -r -p "현재 노드의 클러스터 상태를 덮어씁니다. 계속하려면 restore 입력: " CONFIRM
[ "$CONFIRM" = "restore" ] || { echo "취소"; exit 1; }

# 최신 백업 키 (파일명이 타임스탬프라 사전순 정렬 = 시간순)
SNAP_KEY=$(aws s3 ls "s3://$BUCKET/etcd/" | sort | tail -1 | awk '{print $4}')
PKI_KEY=$(aws s3 ls "s3://$BUCKET/pki/" | sort | tail -1 | awk '{print $4}')
echo "복원 대상: etcd/$SNAP_KEY, pki/$PKI_KEY"

# 부팅 시 만들어진 "새 클러스터"를 먼저 지운다.
kubeadm reset -f || true

# 1) PKI 복원 — CA가 먼저 제자리에 있어야 나머지가 의미를 가진다.
aws s3 cp "s3://$BUCKET/pki/$PKI_KEY" /tmp/pki.tar.gz
rm -rf /etc/kubernetes/pki
tar xzf /tmp/pki.tar.gz -C /

# 2) etcd 데이터 복원. restore는 3.5부터 etcdutl로 옮겨갔고,
#    호스트에 둘 다 없으면 프리풀된 etcd 이미지로 실행한다.
aws s3 cp "s3://$BUCKET/etcd/$SNAP_KEY" /tmp/snapshot.db
rm -rf /var/lib/etcd
if command -v etcdutl >/dev/null 2>&1; then
  etcdutl snapshot restore /tmp/snapshot.db --data-dir /var/lib/etcd
elif command -v etcdctl >/dev/null 2>&1; then
  ETCDCTL_API=3 etcdctl snapshot restore /tmp/snapshot.db --data-dir /var/lib/etcd
else
  ETCD_IMAGE=$(crictl images | awk '/etcd/ {print $1":"$2; exit}')
  ctr -n k8s.io run --rm \
    --mount type=bind,src=/tmp,dst=/tmp,options=rbind:rw \
    --mount type=bind,src=/var/lib,dst=/var/lib,options=rbind:rw \
    "$ETCD_IMAGE" etcd-restore-$$ \
    etcdutl snapshot restore /tmp/snapshot.db --data-dir /var/lib/etcd
fi

# 3) 복원된 PKI·데이터 위에 control plane 재구성.
#    /var/lib/etcd가 이미 차 있는 것은 정상이므로 해당 preflight만 무시한다.
kubeadm init --config /etc/kubernetes/kubeadm-init.yaml \
  --ignore-preflight-errors=DirAvailable--var-lib-etcd

mkdir -p /root/.kube
cp -f /etc/kubernetes/admin.conf /root/.kube/config
chmod 600 /root/.kube/config

# 4) 새 join 토큰 발행. 워커는 복원된 CA를 신뢰하므로 기존 노드도 그대로 붙는다.
/usr/local/bin/publish-join-command.sh
echo "복구 완료. kubectl get nodes 로 확인 후 App ASG를 원래 크기로 되돌릴 것."
EOS
sed -i "s|CARDINAL_BACKUP_BUCKET|${etcd_backup_bucket}|" /usr/local/bin/restore-cluster.sh
chmod +x /usr/local/bin/restore-cluster.sh
%{ endif ~}
